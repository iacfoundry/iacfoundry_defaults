{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Terraform Provider Manifest Schema",
    "description": "A schema describing how Terraform provider documentation manifests should be structured.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "Global": {
            "title": "Global Settings",
            "description": "Settings that apply to the entire provider and all generation processes.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "developer": {
                    "title": "Developer",
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Developer or organization (e.g., hashicorp, databricks).",
                    "default": null,
                    "example": "hashicorp",
                    "details": ""
                },
                "provider": {
                    "title": "Provider",
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Terraform provider name (e.g., azurerm, azuread, aws).",
                    "default": null,
                    "example": "azurerm",
                    "details": ""
                },
                "version": {
                    "title": "Provider Version",
                    "type": "string",
                    "description": "Provider version tag or branch.",
                    "default": "main",
                    "example": "v4.60.0",
                    "details": ""
                },
                "github_url": {
                    "title": "GitHub URL",
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "URL to the provider's GitHub repository, used for version identification.",
                    "default": null,
                    "example": "https://github.com/hashicorp/terraform-provider-azurerm",
                    "details": ""
                },
                "rawMarkdownUrlPattern": {
                    "title": "Raw Markdown URL Pattern",
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "URL pattern to fetch raw markdown documentation. Supports {version} and {resource} placeholders.",
                    "default": null,
                    "example": "https://raw.githubusercontent.com/hashicorp/terraform-provider-azurerm/{version}/website/docs/r/{resource}.html.markdown",
                    "details": ""
                },
                "icon": {
                    "title": "Tile Icon",
                    "description": "Icon for provider tile",
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": "",
                    "example": "azure.png"
                },
                "color": {
                    "title": "Interface Card Color",
                    "description": "Color for the provider card",
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": "#050912",
                    "example": "blue"
                }
            },
            "required": [
                "developer",
                "provider",
                "version",
                "github_url"
            ]
        },
        "Module": {
            "title": "Module Generation Settings",
            "description": "Settings controlling module output behavior.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "secrets": {
                    "title": "Generated Secrets",
                    "description": "Admin credentials generated and stored in Key Vault by default (admin_password, administrator_password, ...). Per managed argument X the module gets X_generate (default on), X_secret_name and X_version, plus secret_key_vault_id / secret_key_vault_name. Uses write-only arguments and ephemeral random_password when the provider has them. Lookup exceptions add or opt out arguments with secret.",
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean", "default": false },
                        "key_vault": { "type": "string", "description": "Resource type of the vault lookup.", "default": "azurerm_key_vault" },
                        "secret_resource": { "type": "string", "default": "azurerm_key_vault_secret" },
                        "read": { "type": "string", "enum": ["data", "ephemeral"], "default": "data", "description": "How an existing secret is read when <arg>_generate = false: data (value in state; works with mock tests) or ephemeral (write-only arguments only, never in state; Terraform mocks do not support it yet)." },
                        "password": {
                            "type": "object",
                            "properties": { "length": { "type": "integer", "default": 24 }, "special": { "type": "boolean", "default": true } },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                "lookup_exceptions": {
                    "title": "Lookup Exceptions File",
                    "description": "File name of this provider version's lookup exceptions, read from defaults/exceptions (bundled) and, in cloud mode, from paths.exceptions in the settings repo. Its lookups merge into resource_mapping (inline entries win). Default: <developer>-<provider>-<version>.json.",
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]+[.]json$"
                },
                "resource_mapping": {
                    "title": "Resource Mapping",
                    "description": "Inline lookups, layered over the lookup exceptions file: \"<argument>\" for every resource, \"<resource_type>.<argument>\" for one.",
                    "type": "object",
                    "additionalProperties": {
                        "oneOf": [
                            {
                                "type": "string",
                                "description": "Name of the Terraform resource type."
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "resource": {
                                        "type": "string",
                                        "description": "Name of the Terraform resource type."
                                    },
                                    "lookup": {
                                        "type": "boolean",
                                        "description": "Whether to generate a lookup variable resolution for this field.",
                                        "default": true
                                    },
                                    "attribute": {
                                        "type": "string",
                                        "description": "Attribute read from the <resource>_output lookup instead of id, for an *_id argument that isn't the target's id.",
                                        "default": "id"
                                    },
                                    "note": {
                                        "type": "string",
                                        "description": "Why this mapping exists. Not used by the generator."
                                    },
                                    "format": {
                                        "type": "string",
                                        "description": "format() string with one %s wrapped around the looked-up value, e.g. /subscriptions/%s around a subscription GUID."
                                    },
                                    "by": {
                                        "type": "string",
                                        "enum": ["name", "key"],
                                        "description": "Match the alias against the target's names (<base>_name) or its module map keys (<base>_key). Default: key for targets with no name attribute."
                                    },
                                    "path": {
                                        "type": "string",
                                        "description": "Nested block the entry is limited to, e.g. custom_parameters. Only used in lookup exceptions files."
                                    }
                                },
                                "required": [
                                    "resource"
                                ],
                                "additionalProperties": false
                            }
                        ]
                    },
                    "default": {},
                    "example": {
                        "resource_group_name": {
                            "resource": "azurerm_resource_group",
                            "lookup": false
                        },
                        "virtual_network_subnet_ids": "azurerm_subnet"
                    }
                },
                "resource_providers": {
                    "title": "Resource Providers",
                    "description": "Define which provider each resource should use. Provider can be an alias or 'all' for multi-provider resources.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "resource": {
                                "type": "string",
                                "description": "The resource name (e.g., 'cluster', 'ip_access_list')"
                            },
                            "provider": {
                                "type": "string",
                                "description": "Provider alias from ProviderFiles.providers or 'all' for both"
                            }
                        },
                        "required": [
                            "resource",
                            "provider"
                        ],
                        "additionalProperties": false
                    },
                    "default": [],
                    "example": [
                        {
                            "resource": "cluster",
                            "provider": "workspace"
                        },
                        {
                            "resource": "ip_access_list",
                            "provider": "all"
                        }
                    ]
                },
                "output_files": {
                    "title": "Output Files",
                    "description": "Control which files are generated for the module.",
                    "type": "object",
                    "properties": {
                        "resource": {
                            "title": "Resource File",
                            "oneOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "enabled": {
                                            "type": "boolean",
                                            "default": true
                                        },
                                        "filename": {
                                            "type": "string",
                                            "description": "Template for filename. Supports variables like {resource}, {provider}."
                                        }
                                    }
                                }
                            ],
                            "default": true
                        },
                        "variables": {
                            "title": "Variables File",
                            "oneOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "enabled": {
                                            "type": "boolean",
                                            "default": true
                                        },
                                        "filename": {
                                            "type": "string",
                                            "description": "Template for filename. Supports variables like {resource}, {provider}."
                                        }
                                    }
                                }
                            ],
                            "default": true
                        },
                        "outputs": {
                            "title": "Outputs File",
                            "oneOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "enabled": {
                                            "type": "boolean",
                                            "default": true
                                        },
                                        "filename": {
                                            "type": "string",
                                            "description": "Template for filename. Supports variables like {resource}, {provider}."
                                        }
                                    }
                                }
                            ],
                            "default": true
                        },
                        "lookup_variables": {
                            "title": "Lookup Variables File",
                            "oneOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "enabled": {
                                            "type": "boolean",
                                            "default": true
                                        },
                                        "filename": {
                                            "type": "string",
                                            "description": "Template for filename. Supports variables like {resource}, {provider}."
                                        }
                                    }
                                }
                            ],
                            "default": true
                        },
                        "readme": {
                            "title": "README.md",
                            "oneOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "enabled": {
                                            "type": "boolean",
                                            "default": true
                                        },
                                        "filename": {
                                            "type": "string",
                                            "description": "Template for filename. Supports variables like {resource}, {provider}."
                                        }
                                    }
                                }
                            ],
                            "default": true
                        },
                        "examples": {
                            "title": "Examples File",
                            "oneOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "enabled": {
                                            "type": "boolean",
                                            "default": true
                                        },
                                        "filename": {
                                            "type": "string",
                                            "description": "Template for filename. Supports variables like {resource}, {provider}."
                                        }
                                    }
                                }
                            ],
                            "default": true
                        },
                        "modules_path": {
                            "title": "zip_modules_path",
                            "type": "string",
                            "description": "Template for directory structure in the valid zip file. Supports {developer}, {provider}, {resource}.",
                            "default": "{developer}/{provider}/{resource}"
                        }
                    },
                    "additionalProperties": false,
                    "default": {
                        "resource": true,
                        "variables": true,
                        "outputs": true,
                        "lookup_variables": true,
                        "readme": true,
                        "examples": true
                    }
                },
                "include_deprecated": {
                    "title": "Include Deprecated",
                    "description": "If enabled (default), arguments and blocks the provider marks as deprecated are generated and labelled 'Deprecated by provider' in variables.tf. Disable to omit them, for example when moving to a new major provider version.",
                    "type": "boolean",
                    "default": true
                },
                "override_readme_callout": {
                    "title": "Override README Callout",
                    "description": "If enabled, each resource README includes a section explaining how to customize the module in a hand-written {resource}.resource_override.tf file, with examples. The generator never creates or overwrites override files; all generated logic stays in the main resource file.",
                    "type": "boolean",
                    "default": false
                },
                "enabled_flag": {
                    "title": "Enabled Flag Name",
                    "description": "Name of the per-entry on/off flag in each <provider>_<resource>_data map: 'resource_enabled' (the default; empty means the same). Use 'enabled' to keep a provider on the old name until its consumers' tfvars are renamed.",
                    "type": "string",
                    "default": "resource_enabled",
                    "enum": [
                        "",
                        "resource_enabled",
                        "enabled"
                    ]
                },
                "exclude_attributes": {
                    "title": "Excluded Attributes",
                    "description": "Top-level attributes left out of a resource's module, per resource: {\"gateway\": [\"min_member_gateway_count\"]}. For attributes that can't be expressed in a for_each module.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "validations": {
                    "title": "Variable Validations",
                    "description": "Generate validation blocks (allowed values, ranges, UUIDs, one-of groups) in each module's variables.tf from the provider rules (public/defaults/provider-rules). Needs a rules file for the provider version.",
                    "type": "boolean"
                },
                "examples": {
                    "title": "Examples",
                    "description": "Settings for generated examples.tfvars. Curated examples (harness/examples) always take precedence.",
                    "type": "object",
                    "properties": {
                        "id_format": {
                            "title": "ID Format",
                            "description": "Shape of example IDs for *_id attributes: 'uuid' (e.g. Fabric) or 'arm' (Azure resource IDs).",
                            "type": "string",
                            "enum": [
                                "uuid",
                                "arm"
                            ]
                        },
                        "location": {
                            "title": "Location",
                            "description": "Example value for location/region attributes, e.g. 'eastus'.",
                            "type": "string"
                        },
                        "values": {
                            "title": "Values",
                            "description": "Example values by attribute name, or '<resource>.<attribute>' for one resource. JSON values, rendered as HCL.",
                            "type": "object",
                            "additionalProperties": true
                        },
                        "include": {
                            "title": "Always Include",
                            "description": "Optional attributes or blocks to always include, for rules the schema doesn't state: 'name', 'path.name' or '<resource>.<path>'.",
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "use_docs": {
                            "title": "Use Provider Docs",
                            "description": "Read hand-written provider docs as hints for example values. Only for providers without provider rules; docs are inconsistent between resources.",
                            "type": "boolean"
                        },
                        "rules": {
                            "title": "Provider Rules Source",
                            "description": "Go entry point for npm run provider-rules (SDKv2 providers only).",
                            "type": "object",
                            "properties": {
                                "go_package": {
                                    "title": "Go Package",
                                    "description": "Import path of the package with the provider function, e.g. github.com/hashicorp/terraform-provider-azurerm/internal/provider.",
                                    "type": "string"
                                },
                                "provider_func": {
                                    "title": "Provider Function",
                                    "description": "Function returning the *schema.Provider, e.g. AzureProvider.",
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            },
            "details": ""
        },
        "ProviderFiles": {
            "title": "Provider Files Settings",
            "description": "Settings creating the provider level files.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "provider_files_path": {
                    "title": "zip_provider_files_path",
                    "type": "string",
                    "description": "Template for directory structure in the valid zip file. Supports {developer}, {provider}.",
                    "default": "{developer}/{provider}"
                },
                "modules_tf": {
                    "title": "Modules Mapping File ({provider}.modules.tf)",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "title": "Enabled",
                            "type": "boolean",
                            "default": true
                        },
                        "filename": {
                            "title": "Filename",
                            "type": "string",
                            "default": "{provider}.modules.tf"
                        }
                    }
                },
                "variables_tf": {
                    "title": "Provider Variables File ({provider}.variables.tf)",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "title": "Enabled",
                            "type": "boolean",
                            "default": true
                        },
                        "filename": {
                            "title": "Filename",
                            "type": "string",
                            "default": "{provider}.variables.tf"
                        }
                    }
                },
                "provider_tf": {
                    "title": "Provider Config File ({provider}.provider.tf)",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "title": "Enabled",
                            "type": "boolean",
                            "default": true
                        },
                        "filename": {
                            "title": "Filename",
                            "type": "string",
                            "default": "{provider}.provider.tf"
                        }
                    }
                },
                "providers": {
                    "title": "Provider Blocks",
                    "description": "Optional named provider blocks that should be generated in provider.tf.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                            "alias": {
                                "title": "Provider Alias",
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "Alias name for this provider block. When set, resources can reference provider = provider.alias.",
                                "default": null
                            },
                            "enabled": {
                                "title": "Enabled",
                                "type": "boolean",
                                "default": true
                            },
                            "config": {
                                "title": "Configuration (HCL)",
                                "type": "string",
                                "description": "Raw HCL configuration for this provider block (content inside the braces).",
                                "default": ""
                            }
                        },
                        "required": [
                            "config"
                        ]
                    }
                },
                "default_provider_alias": {
                    "title": "Default Provider Alias",
                    "description": "If set, resources without a specific provider mapping will use this alias.",
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null
                },
                "defaults": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": false
                        },
                        "variable_format": {
                            "type": "string",
                            "default": "module.defaults.merge[\"{resource}\"]"
                        },
                        "module_path": {
                            "title": "Defaults Module Path",
                            "description": "Folder of the generated defaults module, under the provider files path. Default: _defaults.",
                            "type": "string"
                        },
                        "root_variables_file": {
                            "title": "Root Variables File",
                            "description": "Optional provider-level file the generator writes with the <provider>_global_defaults and <provider>_environment_defaults variables. Leave unset when that file holds other variables.",
                            "type": "string"
                        },
                        "attributes": {
                            "title": "Default Attributes",
                            "description": "Attributes the generated defaults module fills in. Resource types take an attribute when they have a configurable top-level argument of that name (or, for <x>_name, an <x>_id looked up by name). Required arguments with a coalesce default become optional in module variables.",
                            "type": "object",
                            "additionalProperties": {
                                "type": "object",
                                "properties": {
                                    "strategy": {
                                        "type": "string",
                                        "enum": ["merge", "coalesce"],
                                        "description": "merge: the entry's map over environment over global. coalesce: the entry's value, else environment, else global."
                                    },
                                    "type": {
                                        "type": "string",
                                        "description": "HCL type for the defaults variables. Default: the schema's most common type for the attribute."
                                    },
                                    "description": { "type": "string" }
                                },
                                "required": ["strategy"],
                                "additionalProperties": false
                            }
                        },
                        "registry": {
                            "title": "Defaults Registry",
                            "description": "Map in a provider-level file that lists every module's data (azurerm: resource_data in defaults.modules.tf). Entries are added and removed by key as modules are generated.",
                            "type": "object",
                            "properties": {
                                "file": {
                                    "title": "File",
                                    "description": "Provider-level file, e.g. defaults.modules.tf.",
                                    "type": "string"
                                },
                                "map": {
                                    "title": "Map",
                                    "description": "Map attribute name, e.g. resource_data.",
                                    "type": "string"
                                },
                                "entry": {
                                    "title": "Entry Value",
                                    "description": "Value template, e.g. var.{full_name}_data.",
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "tests_hcl": {
                    "title": "Test Framework (.tftest.hcl)",
                    "description": "Settings for automated Terraform module testing.",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "title": "Enable Tests",
                            "type": "boolean",
                            "default": true
                        },
                        "filename": {
                            "title": "Filename Template",
                            "type": "string",
                            "default": "{provider}.tftest.hcl"
                        },
                        "header": {
                            "title": "File Header (HCL)",
                            "type": "string",
                            "description": "Custom header comments for the test file.",
                            "default": "# --------------------------------------------------------------\n# Terraform Module Tests\n# Contributor(s): William Robinson\n# Created: March 2026\n# Updated: April 2026\n# Purpose: Terraform Resource Module Test Provider and run steps\n# --------------------------------------------------------------"
                        },
                        "mock_providers": {
                            "title": "Extra Mock Providers",
                            "description": "Other providers the provider block reads from, mocked in the provider's test file (e.g. ['azurerm'] for data.azurerm_client_config).",
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "root_mock": {
                            "title": "Mock in Repo Root Test",
                            "description": "Set to false for providers that need no credentials (random, time, tls), so the repo-root tests/terraform.tftest.hcl gets no mock for them. Leave unset to include the mock.",
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "ResourceGraph": {
            "title": "Resource Graph Settings",
            "description": "Defines settings for dependency graph visualization.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "defaultResource": {
                    "title": "Default Resource",
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Resource shown first when graph loads.",
                    "default": null,
                    "example": "subscription",
                    "details": ""
                },
                "enableFullDependencyScan": {
                    "title": "Enable Full Dependency Scan",
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "description": "If true, scans all resources for incoming references.",
                    "default": false,
                    "example": false,
                    "details": ""
                }
            },
            "required": []
        },
        "ImportSettings": {
            "title": "Import Settings",
            "description": "Settings for the resource import feature, enabling discovery and import of existing cloud resources into Terraform.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "portalUrl": {
                    "title": "Provider Portal URL",
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The URL of the provider's management console or portal.",
                    "default": null,
                    "example": "https://portal.azure.com"
                },
                "importToPattern": {
                    "title": "Import 'To' Block Pattern",
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The format pattern for the 'to' attribute in generated block. You can use '{resource}' for the resource type and '{name}' or '{key}' for the cleaned item name. Example: 'module.{resource}[\"{key}\"]'.",
                    "default": null,
                    "example": "module.azurerm_defaults.merge[\"{resource}\"]"
                },
                "startingResource": {
                    "title": "Starting Resource",
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The root Terraform resource type to begin resource enumeration from.",
                    "default": null,
                    "example": "azurerm_subscription"
                },
                "filterHierarchy": {
                    "title": "Filter Hierarchy",
                    "description": "Ordered list of filterable scopes for narrowing resource discovery. Each entry defines a level in the hierarchy presented as a filter in the UI.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Display name for this filter level."
                            },
                            "field": {
                                "type": "string",
                                "description": "The API field or property this filter maps to."
                            },
                            "resourceType": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "The Terraform resource type this filter level corresponds to."
                            }
                        },
                        "required": [
                            "name",
                            "field"
                        ],
                        "additionalProperties": false
                    },
                    "default": []
                },
                "authOptions": {
                    "title": "Authentication Options",
                    "description": "Available authentication methods for this provider. Each option defines a different way to authenticate, with its own set of credential fields. Actual credential values are stored in app settings, never in the manifest.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "description": "Unique identifier for this auth method (e.g., 'service_principal', 'access_key')."
                            },
                            "name": {
