{
  "Global": {
    "developer": "snowflakedb",
    "provider": "snowflake",
    "version": "v2.10.0",
    "rawMarkdownUrlPattern": "https://raw.githubusercontent.com/Snowflake-Labs/terraform-provider-snowflake/{version}/docs/resources/{resource}.md",
    "color": "#76bff0",
    "icon": "snowflake.png",
    "github_url": "https://github.com/Snowflake-Labs/terraform-provider-snowflake"
  },
  "Module": {
    "override_readme_callout": false
  },
  "ProviderFiles": {
    "provider_files_path": "{developer}/{provider}",
    "modules_tf": {
      "filename": "{provider}.modules.tf",
      "enabled": true
    },
    "variables_tf": {
      "filename": "{provider}.variables.tf",
      "enabled": true
    },
    "provider_tf": {
      "filename": "{provider}.provider.tf",
      "enabled": true
    },
    "tests_hcl": {
      "enabled": true,
      "filename": "{provider}.tftest.hcl",
      "header": "# --------------------------------------------------------------\n# Terraform Module Tests\n# Contributor(s): William Robinson\n# Created: March 2026\n# Updated: April 2026\n# Purpose: Terraform Resource Module Test Provider and run steps\n# --------------------------------------------------------------"
    }
  },
  "ResourceGraph": {
    "defaultResource": "database",
    "enableFullDependencyScan": false
  }
}