{
  "Global": {
    "developer": "hashicorp",
    "provider": "google",
    "version": "v7.10.0",
    "rawMarkdownUrlPattern": "https://raw.githubusercontent.com/hashicorp/terraform-provider-google/{version}/website/docs/r/{resource}.html.markdown",
    "color": "#c84436",
    "icon": "google-cloud.svg",
    "github_url": "https://github.com/hashicorp/terraform-provider-google"
  },
  "Module": {
    "override_readme_callout": false
  },
  "ProviderFiles": {
    "provider_files_path": "{developer}/{provider}",
    "modules_tf": {
      "filename": "{provider}.modules.tf",
      "enabled": true
    },
    "variables_tf": {
      "filename": "{provider}.variables.tf",
      "enabled": true
    },
    "provider_tf": {
      "filename": "{provider}.provider.tf",
      "enabled": true
    },
    "tests_hcl": {
      "enabled": true,
      "filename": "{provider}.tftest.hcl",
      "header": "# --------------------------------------------------------------\n# Terraform Module Tests\n# Contributor(s): William Robinson\n# Created: March 2026\n# Updated: April 2026\n# Purpose: Terraform Resource Module Test Provider and run steps\n# --------------------------------------------------------------"
    }
  },
  "ResourceGraph": {
    "defaultResource": "compute_instance",
    "enableFullDependencyScan": false
  }
}