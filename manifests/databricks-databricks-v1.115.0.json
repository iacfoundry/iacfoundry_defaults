  "ProviderFiles": {
    "provider_files_path": "{developer}/{provider}",
    "modules_tf": {
      "enabled": true,
      "filename": "{provider}.modules.tf"
    },
    "variables_tf": {
      "enabled": true,
      "filename": "{provider}.variables.tf"
    },
    "provider_tf": {
      "enabled": true,
      "filename": "{provider}.provider.tf"
    },
    "default_provider_alias": "account",
    "defaults": {
      "enabled": false,
      "variable_format": "module.defaults.merge[\"{resource}\"]"
    },
    "tests_hcl": {
      "enabled": true,
      "filename": "{provider}.tftest.hcl",
      "header": "# --------------------------------------------------------------\n# Terraform Module Tests\n# Contributor(s): William Robinson\n# Created: March 2026\n# Updated: April 2026\n# Purpose: Terraform Resource Module Test Provider and run steps\n# --------------------------------------------------------------"
    },
    "providers": [
      {
        "alias": null,
        "enabled": true,
        "config": "host            = \"https://accounts.azuredatabricks.net\"\nauth_type       = \"github-oidc-azure\"\naccount_id      = var.databricks_account_id\nazure_client_id = data.azurerm_client_config.current.client_id\nazure_tenant_id = data.azurerm_client_config.current.tenant_id"
      },
      {
        "alias": "workspace",
        "enabled": true,
        "config": "auth_type       = \"github-oidc-azure\"\nhost            = var.databricks_workspace\nazure_client_id = data.azurerm_client_config.current.client_id\nazure_tenant_id = data.azurerm_client_config.current.tenant_id"
      }
    ]
