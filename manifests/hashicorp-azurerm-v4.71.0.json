{
  "Global": {
    "developer": "hashicorp",
    "provider": "azurerm",
    "color": "#4879d1",
    "icon": "azurerm.png",
    "version": "v4.71.0",
    "github_url": "https://github.com/hashicorp/terraform-provider-azurerm",
    "rawMarkdownUrlPattern": "https://raw.githubusercontent.com/hashicorp/terraform-provider-azurerm/{version}/website/docs/r/{resource}.html.markdown"
  },
  "Module": {
    "enabled_flag": "resource_enabled",
    "secrets": {
      "enabled": true,
      "key_vault": "azurerm_key_vault",
      "password": { "length": 24, "special": true }
    },
    "lookup_exceptions": "hashicorp-azurerm-v4.71.0.json",
    "override_readme_callout": true,
    "resource_mapping": {
      "resource_group_name": {
        "resource": "azurerm_resource_group",
        "lookup": false
      },
      "virtual_network_name": {
        "resource": "azurerm_virtual_network",
        "lookup": false
      },
      "virtual_network_subnet_ids": "azurerm_subnet",
      "public_ip_address_id": "azurerm_public_ip"
    },
    "output_files": {
      "resource": true,
      "variables": true,
      "outputs": true,
      "lookup_variables": true,
      "readme": true,
      "examples": true,
      "modules_path": "{developer}/{provider}/{resource}"
    },
    "examples": {
      "id_format": "arm",
      "location": "eastus",
      "rules": {
        "go_package": "github.com/hashicorp/terraform-provider-azurerm/internal/provider",
        "provider_func": "AzureProvider"
      }
    },
    "validations": true
  },
  "ProviderFiles": {
    "provider_files_path": "{developer}/{provider}",
    "modules_tf": {
      "filename": "{provider}.modules.tf",
      "enabled": true
    },
    "variables_tf": {
      "filename": "{provider}.variables.tf",
      "enabled": true
    },
    "provider_tf": {
      "filename": "{provider}.provider.tf",
      "enabled": true
    },
    "defaults": {
      "variable_format": "module.azurerm_defaults.merge[\"{resource}\"]",
      "enabled": false
    },
    "tests_hcl": {
      "enabled": true,
      "filename": "{provider}.tftest.hcl",
      "header": "# --------------------------------------------------------------\n# Terraform Module Tests\n# Contributor(s): William Robinson\n# Created: March 2026\n# Updated: April 2026\n# Purpose: Terraform Resource Module Test Provider and run steps\n# --------------------------------------------------------------"
    }
  },
  "ResourceGraph": {
    "defaultResource": "subscription",
    "enableFullDependencyScan": false
  },
  "ImportSettings": {
    "portalUrl": "https://portal.azure.com",
    "startingResource": "azurerm_subscription",
    "filterHierarchy": [
      {
        "name": "Management Group",
        "field": "managementGroup",
        "resourceType": "azurerm_management_group"
      },
      {
        "name": "Subscription",
        "field": "subscription",
        "resourceType": "azurerm_subscription"
      },
      {
        "name": "Resource Group",
        "field": "resourceGroup",
        "resourceType": "azurerm_resource_group"
      }
    ],
    "authOptions": [
      {
        "id": "service_principal",
        "name": "Service Principal",
        "properties": {
          "tenant_id": {
            "title": "Tenant ID",
            "type": [
              "string"
            ],
            "description": "Azure AD Tenant (Directory) ID.",
            "sensitive": false
          },
          "client_id": {
            "title": "Client ID",
            "type": [
              "string"
            ],
            "description": "Application (client) ID of the Service Principal.",
            "sensitive": false
          },
          "client_secret": {
            "title": "Client Secret",
            "type": [
              "string"
            ],
            "description": "Client secret for the Service Principal.",
            "sensitive": true
          },
          "subscriptions": {
            "title": "Subscriptions",
            "type": [
              "string"
            ],
            "description": "Optional. Subscription IDs to scan, separated by commas; leave empty for every subscription the identity can read.",
            "sensitive": false
          }
        }
      },
      {
        "id": "azure_cli",
        "name": "Azure CLI (az login on the IaC Foundry host)",
        "properties": {
          "tenant_id": {
            "title": "Tenant ID",
            "type": [
              "string"
            ],
            "description": "Optional. Tenant to get the token for; leave empty for the az default.",
            "sensitive": false
          },
          "subscriptions": {
            "title": "Subscriptions",
            "type": [
              "string"
            ],
            "description": "Optional. Subscription IDs to scan, separated by commas; leave empty for every subscription the identity can read.",
            "sensitive": false
          }
        }
      },
      {
        "id": "device_code",
        "name": "Device Code (sign in on any device)",
        "properties": {
          "tenant_id": {
            "title": "Tenant ID",
            "type": [
              "string"
            ],
            "description": "Optional. Tenant (directory) ID or domain; leave empty for your home tenant. Needed for guest access to another tenant.",
            "sensitive": false
          },
          "client_id": {
            "title": "Client ID",
            "type": [
              "string"
            ],
            "description": "Optional. Application (client) ID of your own public client app registration; leave empty to use the Azure CLI app.",
            "sensitive": false
          },
          "subscriptions": {
            "title": "Subscriptions",
            "type": [
              "string"
            ],
            "description": "Optional. Subscription IDs to scan, separated by commas; leave empty for every subscription the identity can read.",
            "sensitive": false
          }
        }
      },
      {
        "id": "interactive",
        "name": "Interactive Login (browser pop-up)",
        "properties": {
          "tenant_id": {
            "title": "Tenant ID",
            "type": [
              "string"
            ],
            "description": "Optional. Tenant (directory) ID or domain; leave empty for your home tenant. Needed for guest access to another tenant.",
            "sensitive": false
          },
          "client_id": {
            "title": "Client ID",
            "type": [
              "string"
            ],
            "description": "Optional. Application (client) ID of your own public client app registration; leave empty to use the Azure CLI app.",
            "sensitive": false
          },
          "subscriptions": {
            "title": "Subscriptions",
            "type": [
              "string"
            ],
            "description": "Optional. Subscription IDs to scan, separated by commas; leave empty for every subscription the identity can read.",
            "sensitive": false
          }
        }
      }
    ],
    "managedByIndicator": {
      "method": "tag",
      "tagKey": "managedby",
      "tagValue": "terraform"
    },
    "resourceIdPattern": "/subscriptions/{subscription_id}/resourceGroups/{resource_group_name}/providers/{resource_provider}/{resource_type}/{resource_name}"
  }
}